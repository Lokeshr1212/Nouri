# ---- Nouri backend environment variables ----
# Copy this file to .env and fill in real values. Never commit .env.

# Server
# ------------------------------------------------------------------
PORT=5000
NODE_ENV=development

# Database (PostgreSQL). Example for a local install:
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/nouri?schema=public
DATABASE_URL=

# Authentication
# ------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=1h
REFRESH_TOKEN_TTL_DAYS=7
SALT_ROUNDS=12

# Frontend / CORS
# ------------------------------------------------------------------
# Origin the frontend is served from. When SERVE_FRONTEND=true the app is
# available at exactly this origin, so browser requests are same-origin.
FRONTEND_URL=http://localhost:5000
# Optional extra comma-separated origins, e.g. http://localhost:5500,http://127.0.0.1:5500
CORS_ORIGINS=

# Serve the existing frontend statically from the backend (dev mode).
SERVE_FRONTEND=true
# Path relative to the backend folder.
FRONTEND_DIR=../frontend(nauri)

# File uploads
# ------------------------------------------------------------------
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5mb

# AI - food analysis & diet plan generation
# ------------------------------------------------------------------
# mock | gemini
AI_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Optional real nutrition lookup provider (currently mock only)
NUTRITION_PROVIDER=mock

# Email / password reset
# ------------------------------------------------------------------
# Leave SMTP_* empty to log reset links to the console instead of emailing.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Nouri <no-reply@nouri.app>
# In development, also return the reset token in the API response so the
# flow can be completed without an email server. Disable in production.
DEV_RETURN_RESET_TOKEN=true

# Google Sign-In (optional - leave empty to disable)
# ------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=